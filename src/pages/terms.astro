</BaseLayout>

<style>
.kicker {
  font-family: var(--font-mono);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.78rem;
  color: var(--accent-3);
  margin: 0 0 0.4rem;
}
</style>
