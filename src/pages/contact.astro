---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Contact"
  description="Get in touch with the Floor is Rising team."
>
  <h1>Contact</h1>
  <div class="prose">
    <p>
      For show-related inquiries, email
      <a href="mailto:hello@floorisrising.com">hello@floorisrising.com</a>.
    </p>
    <p>
      Press, partnership, or sponsorship inquiries are welcome — please
      include "Press" or "Sponsor" in your subject line.
    </p>
    <p class="muted small">
      Replace this copy with the real contact details before launch.
    </p>
  </div>
</BaseLayout>
