# Cloudflare R2 — S3-compatible API credentials
# Generated under: R2 → Manage R2 API Tokens → "Object Read & Write" on bucket floorisrising-media
# Copy this file to `.env` (which is gitignored) and fill in real values there.

# Your Cloudflare account ID. Find it on the Cloudflare dashboard sidebar,
# or in any R2 endpoint URL (https://<ACCOUNT_ID>.r2.cloudflarestorage.com).
R2_ACCOUNT_ID=

# The Access Key ID shown when you created the R2 API token.
R2_ACCESS_KEY_ID=

# The Secret Access Key shown ONCE when you created the token.
# If you don't have it, regenerate the token.
R2_SECRET_ACCESS_KEY=

# Bucket name (already created in Phase A).
R2_BUCKET=floorisrising-media

# S3 endpoint for this account. Usually:
#   https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# Leave commented to let scripts derive it from R2_ACCOUNT_ID.
# R2_ENDPOINT=

# Public URL prefix for served objects (R2 custom domain, set up in Phase A).
# Used to build <enclosure> URLs in the RSS feed and src URLs for the audio player.
R2_PUBLIC_BASE=https://media.floorisrising.com
